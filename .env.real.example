COMPOSE_PROJECT_NAME=agrojud-real
AGROJUD_ENV=real
API_PORT=8001
FRONTEND_PORT=5174
POSTGRES_DB=agrojud_real
POSTGRES_USER=agrojud
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_SECRET
DATABASE_URL=postgresql+psycopg://agrojud:REPLACE_WITH_A_LOCAL_SECRET@db:5432/agrojud_real
DATAJUD_API_KEY=
DATAJUD_READ_TIMEOUT_SECONDS=60
# Keep disabled until an approved SPEC-024 matrix and its SHA-256 are promoted.
DATAJUD_MULTITRIBUNAL_ENABLED=false
DATAJUD_MULTITRIBUNAL_MATRIX_HOST_PATH=./docs/evidence/datajud-multitribunal-2026-10-11-lote-01/matrix-merged-after-tjms-rerun-reviewed.json
DATAJUD_MULTITRIBUNAL_MATRIX_PATH=/run/agrojud/matrix-reviewed.json
DATAJUD_MULTITRIBUNAL_MATRIX_SHA256=
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20
JOB_POLL_SECONDS=2
EXPORT_PROCESS_LIMIT=50000
FRONTEND_ORIGIN=http://127.0.0.1:5174
