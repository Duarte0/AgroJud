COMPOSE_PROJECT_NAME=agrojud-demo
AGROJUD_ENV=demo
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_DB=agrojud_demo
POSTGRES_USER=agrojud
# Local demonstration credential only; replace for any shared environment.
POSTGRES_PASSWORD=agrojud-demo-local
DATABASE_URL=postgresql+psycopg://agrojud:agrojud-demo-local@db:5432/agrojud_demo
DATAJUD_API_KEY=
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20
JOB_POLL_SECONDS=2
EXPORT_PROCESS_LIMIT=50000
FRONTEND_ORIGIN=http://127.0.0.1:5173
