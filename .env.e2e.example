COMPOSE_PROJECT_NAME=agrojud-e2e
AGROJUD_ENV=demo
API_PORT=18765
POSTGRES_DB=agrojud_e2e
POSTGRES_USER=agrojud_e2e
# Local browser-test credential only; the database is ephemeral (tmpfs).
POSTGRES_PASSWORD=agrojud-e2e-local
DATABASE_URL=postgresql+psycopg://agrojud_e2e:agrojud-e2e-local@db:5432/agrojud_e2e
DATAJUD_API_KEY=
JOB_LEASE_SECONDS=30
JOB_HEARTBEAT_SECONDS=5
JOB_POLL_SECONDS=1
EXPORT_PROCESS_LIMIT=50000
FRONTEND_ORIGIN=http://127.0.0.1:4173
